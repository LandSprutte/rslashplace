# Copied to /etc/default/rslashplace. Overrides the defaults in the systemd
# unit, so this file is where you choose how the app is exposed.
#
#   Direct mode   -- browser hits http://<instance-ip>:3000 with no proxy.
#                    HOST must be 0.0.0.0 so the app accepts outside traffic.
#   Proxied mode  -- Caddy terminates TLS on 443 and forwards to the app.
#                    HOST must be 127.0.0.1 so the app is not publicly reachable.
#
# Direct mode (default):
HOST=0.0.0.0
PORT=3000

# Proxied mode -- comment out the two lines above and uncomment these:
#HOST=127.0.0.1
#PORT=3000
