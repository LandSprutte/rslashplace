[Unit]
Description=r/place clone (Bun WebSocket server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rslashplace
Group=rslashplace
WorkingDirectory=/opt/rslashplace
ExecStart=/usr/local/bin/bun /opt/rslashplace/server.ts

Environment=DATA_FILE=/var/lib/rslashplace/canvas.json
Environment=NODE_ENV=production
# Defaults suit proxied mode (loopback only). /etc/default/rslashplace is read
# last, so it overrides these -- that file is what selects direct vs proxied.
Environment=HOST=127.0.0.1
Environment=PORT=3000
EnvironmentFile=-/etc/default/rslashplace

# Needed only if you set PORT below 1024 in direct mode; harmless otherwise.
AmbientCapabilities=CAP_NET_BIND_SERVICE

Restart=always
RestartSec=2
# Give the shutdown handler time to flush the canvas to disk.
KillSignal=SIGTERM
TimeoutStopSec=10

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rslashplace
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rslashplace

[Install]
WantedBy=multi-user.target
